# Offline by default. Copy this file to .env; never commit the latter.
CP_PROVIDER=disabled
# Local Ollama: CP_PROVIDER=ollama; CP_MODEL=<an installed model name>
CP_BASE_URL=http://localhost:11434
CP_MODEL=
CP_API_KEY=
# For an OpenAI-compatible service use CP_PROVIDER=openai_compatible
# CP_BASE_URL=https://your-provider.example/v1
# Set true only after explicitly authorizing remote/possibly paid requests.
CP_ALLOW_PAID=false
CP_TEMPERATURE=0
CP_MAX_TOKENS=1200
CP_TIMEOUT=60
